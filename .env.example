# Runtime environment template. Keep real credentials in Catalyst secrets or a local
# ignored `.env` file; never commit values here.
APP_ENV=local
LOG_LEVEL=INFO

# Catalyst identifiers (required for APP_ENV=catalyst or production)
CATALYST_PROJECT_ID=
CATALYST_APP_ID=
CATALYST_ENVIRONMENT=development
CATALYST_API_BASE_URL=
FRONTEND_ORIGIN=

# Data and platform feature flags. SDK adapters are added in P03.
CATALYST_DATA_STORE_ID=
CATALYST_DATA_STORE_ENABLED=false
CATALYST_CACHE_ENABLED=false
CATALYST_STRATUS_ENABLED=false
CATALYST_AUTH_ENABLED=false
CATALYST_EXTERNAL_ENABLED=false
NEO4J_ENABLED=false
LLM_ENABLED=false

# Neo4j AppSail connection. Bolt and HTTP ports are locked by architecture.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# LLM provider credentials. Blank values are valid for local deterministic tests.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Locked model chain and local inference models.
PRIMARY_MODEL=groq/llama-3.3-70b-versatile
REASONING_MODEL=gemini/gemini-2.5-flash
FALLBACK_MODEL=mistral/mistral-small-latest
EMERGENCY_FALLBACK_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free
EMBEDDING_MODEL=AlpEge/bge-m3-onnx-int8
RERANKER_MODEL=Sophia-AI/bge-reranker-v2-m3-onnx
EMBEDDING_DIMENSIONS=1024

# Locked execution limits (seconds).
API_TIMEOUT_SECONDS=30
SIGNAL_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=300
